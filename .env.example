# Database connection strings (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Public API & Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Vercel Cron Secret (Daily reminders & keepalive)
CRON_SECRET="your-cron-secret-token"

# Telegram Bot (Optional Phase 1 notification)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="OmahFamilyBot"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# WhatsApp Gateway (WAHA - Phase 2 notification)
WAHA_BASE_URL="http://localhost:3008"
WAHA_API_KEY="your-waha-api-key"

# Google Gemini API (Gratis di https://aistudio.google.com - Scan Bukti Transfer / myBCA / QRIS)
GEMINI_API_KEY="your-gemini-api-key"
