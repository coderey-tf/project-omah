# ==============================================================================
# Omah — Project Git Ignore
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Outputs
.next/
out/
build/
dist/

# Environment Variables & Secrets (Keep .env.example committed)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# AI Agents & IDE Tooling
.agent/
.agents/
.claude/
.gemini/
.impeccable/
scratch/

# IDE & Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# TypeScript & Next.js cache
*.tsbuildinfo
next-env.d.ts

# Vercel CLI
.vercel

# Local Database Dumps & Backups
*.dump
*.backup
*.sqlite
*.sqlite-journal
backups/

# WAHA (WhatsApp Gateway) Local Session Storage
.waha/
waha-data/
sessions/
*.session
